import numpy as np
import matplotlib.pyplot as plt

# Positional Encoding
def positional_encoding(seq_len, embed_dim):
    position = np.arange(seq_len)[:, np.newaxis]
    i = np.arange(embed_dim)[np.newaxis, :]
    angle_rates = 1 / np.power(10000, (2 * (i // 2)) / np.float32(embed_dim))
    angle_rads = position * angle_rates
    #Apply sin to even indices and cos to odd indices
    positional_encoding = np.zeros((seq_len, embed_dim))
    positional_encoding[:, 0::2] = np.sin(angle_rads[:, 0::2])
    positional_encoding[:, 1::2] = np.cos(angle_rads[:, 1::2])
    return positional_encoding

#Generate and visualize positional encoding
seq_length = 50
embedding_dim = 16
pos_encoding = positional_encoding(seq_length, embedding_dim)
plt.figure(figsize=(10, 6))
plt.imshow(pos_encoding, cmap='viridis')
plt.colorbar()
plt.title('Positional Encoding')
plt.show()

import torch
import torch.nn as nn
class PositionalEncoding(nn.Module):
    def __init__(self, embed_dim, max_len=5000,num_heads=8,ff_dim=2048):
        super(PositionalEncoding, self).__init__()
        self.embedding = nn.Embedding(max_len, embed_dim)
        self.positional_encoding = nn.Parameter(torch.tensor(positional_encoding(max_len, embed_dim)), requires_grad=False)
        self.multi_head_attention = nn.MultiheadAttention(embed_dim, num_heads)
        self.feed_forward = nn.Sequential(
            nn.Linear(embed_dim, ff_dim),
            nn.ReLU(),
            nn.Linear(ff_dim, embed_dim)
        )
        self.layer_norm1 = nn.LayerNorm(embed_dim)
        self.layer_norm2 = nn.LayerNorm(embed_dim)
    def forward(self, x):
        #Add Positional Encoding
        x = self.embedding(x) + self.positional_encoding[:x.size(1), :]
        #self-attention
        attn_output, _ = self.multi_head_attention(x, x, x)
        x = self.layer_norm1(x + attn_output)  # Residual connection
        #Feed-forward network
        ff_output = self.feed_forward(x)
        x = self.layer_norm2(x + ff_output)  # Residual connection
        return x
    
    
    #Define model parameters
embed_dim = 64
num_heads = 8
ff_dim = 256
max_len = 100

model = PositionalEncoding(embed_dim, max_len, num_heads, ff_dim)
print(model)
#learanable positional encoding example
class LearnablePositionalEncoding(nn.Module):
    def __init__(self, embed_dim, max_len=5000):
        super(LearnablePositionalEncoding, self).__init__()
        self.positional_encoding = nn.Parameter(torch.rand(max_len, embed_dim))
    def forward(self, x):
        return x + self.positional_encoding[:x.size(1), :]
learnable_pos_encoding = LearnablePositionalEncoding(embed_dim, max_len)
print(learnable_pos_encoding)